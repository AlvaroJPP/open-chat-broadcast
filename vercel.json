{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "{config,routers,controllers,services,models}/**/*",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/rooms/(.*)",
      "destination": "/index.html"
    }
  ]
}
