# Frontend (Vite)
# Desenvolvimento local: use /api para passar pelo proxy do Vite.
VITE_API_BASE_URL=/api

# "true" ativa dados mock; "false" usa o backend configurado acima.
VITE_USE_MOCK_DATA=false

# Para produção (Vercel), configure VITE_API_BASE_URL nas Environment Variables:
# VITE_API_BASE_URL=https://open-chat-broadcast.onrender.com/api
# VITE_USE_MOCK_DATA=false

# Portas usadas pelo ambiente local (vite.config.ts)
FRONT_PORT=5175
PORT=3000
